if(NOT DEFINED source_dir)
  get_filename_component(source_dir "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
if(NOT DEFINED baseline)
  set(baseline "${source_dir}/testdata/benchmarks/libmdf-baseline.json")
endif()
file(READ "${baseline}" reference)
foreach(option rounds warmups repeat allowance)
  if(NOT DEFINED ${option})
    string(JSON ${option} GET "${reference}" ${option})
  endif()
endforeach()
if(NOT DEFINED attempts)
  set(attempts 3)
endif()
if(NOT attempts MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "attempts must be positive")
endif()
string(JSON input GET "${reference}" input)
set(extra)
if(no_lua)
  list(APPEND extra --no-lua)
endif()
foreach(attempt RANGE 1 ${attempts})
  execute_process(COMMAND "${source_dir}/scripts/benchmark.sh" api --no-build
    --input "${input}" --rounds "${rounds}" --warmups "${warmups}" --repeat "${repeat}"
    --json ${extra} RESULT_VARIABLE result OUTPUT_VARIABLE measured)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Benchmark attempt failed: ${result}")
  endif()
  string(JSON count LENGTH "${measured}" results)
  math(EXPR last "${count} - 1")
  foreach(i RANGE 0 ${last})
    string(JSON impl GET "${measured}" results ${i} impl)
    string(JSON mode GET "${measured}" results ${i} mode)
    string(JSON median GET "${measured}" results ${i} stats median)
    set(key "${impl}/${mode}")
    if(NOT DEFINED best_${key} OR median LESS best_${key})
      set(best_${key} "${median}")
    endif()
  endforeach()
endforeach()
string(JSON count LENGTH "${reference}" results)
if(count LESS 1)
  message(FATAL_ERROR "Benchmark baseline is empty")
endif()
math(EXPR last "${count} - 1")
set(failed FALSE)
foreach(i RANGE 0 ${last})
  string(JSON impl GET "${reference}" results ${i} impl)
  string(JSON mode GET "${reference}" results ${i} mode)
  string(JSON expected GET "${reference}" results ${i} median_s)
  if(no_lua AND impl STREQUAL "Lua API")
    continue()
  endif()
  set(key "${impl}/${mode}")
  if(NOT DEFINED best_${key})
    message(FATAL_ERROR "Missing required benchmark path: ${key}")
  endif()
  execute_process(COMMAND "${source_dir}/build/debug/benchmark_command" --compare
    "${best_${key}}" "${expected}" "${allowance}" RESULT_VARIABLE result OUTPUT_VARIABLE detail)
  message(STATUS "${key}: ${detail}")
  if(NOT result EQUAL 0)
    set(failed TRUE)
  endif()
endforeach()
if(failed)
  message(FATAL_ERROR "Benchmark medians exceeded their declared allowance")
endif()
