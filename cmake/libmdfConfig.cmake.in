@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/libmdfTargets.cmake")

# Development consumers opt in explicitly. The consuming project must select a
# Bootlin toolchain; installed SDK metadata itself remains relocatable.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  function(libmdf_configure_development_runtime target)
    if(NOT DEFINED LIBMDF_BOOTLIN_LOADER OR NOT DEFINED LIBMDF_BOOTLIN_RUNTIME_RPATH)
      message(FATAL_ERROR
        "libmdf development executables require a Bootlin CMAKE_TOOLCHAIN_FILE")
    endif()
    target_link_options(${target} PRIVATE
      "-Wl,--dynamic-linker,${LIBMDF_BOOTLIN_LOADER}"
      "-Wl,--disable-new-dtags,-rpath,${LIBMDF_BOOTLIN_RUNTIME_RPATH}")
  endfunction()
endif()
