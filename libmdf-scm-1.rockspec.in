package = "libmdf"
version = "@VERSION@-1"
source = { url = "git+file://." }
description = {
  summary = "Lua facade for libmdf",
  license = "MIT"
}
dependencies = { "lua >= 5.5, < 5.6" }
external_dependencies = {
  MDF = {
    header = "libmdf/mdf.h",
    library = "mdf"
  }
}
build = {
  type = "builtin",
  modules = {
    libmdf = "lua/libmdf.lua",
    ["libmdf.core"] = {
      sources = { "lua/libmdf_core.c" },
      libraries = { "mdf" },
      incdirs = { "$(MDF_INCDIR)" },
      libdirs = { "$(MDF_LIBDIR)" }
    }
  }
}
