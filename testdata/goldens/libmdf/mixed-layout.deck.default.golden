<span class="mdf-line mdf-chart-line" style="display:block;white-space:pre;overflow-wrap:normal;text-align:center;"><span class="mdf-prefix"></span><span class="mdf-content" style="display:inline-block;white-space:pre;overflow-wrap:normal;text-align:left;"><span style="color:rgb(255,215,175);background-color:rgb(255,215,175);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;font-weight:700;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(255,215,175);">███████</span></span><span style="color:rgb(0,0,0);background-color:rgb(255,215,175);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;">Tests</span><span style="color:rgb(255,215,175);background-color:rgb(255,215,175);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;font-weight:700;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(255,215,175);">███████</span></span><span style="color:rgb(175,175,95);background-color:rgb(175,175,95);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;font-weight:700;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(175,175,95);">██████</span></span><span style="color:rgb(0,0,0);background-color:rgb(175,175,95);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;">HTML</span><span style="color:rgb(175,175,95);background-color:rgb(175,175,95);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;font-weight:700;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(175,175,95);">███████</span></span><span style="color:rgb(135,175,135);background-color:rgb(135,175,135);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;font-weight:700;"><sp