ck;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(175,175,0);">███</span></span></span></span><span class="mdf-line mdf-chart-line" style="display:block;white-space:pre;overflow-wrap:normal;text-align:center;"><span class="mdf-prefix"></span><span class="mdf-content" style="display:inline-block;white-space:pre;overflow-wrap:normal;text-align:left;"><span style="color:rgb(255,215,175);background-color:rgb(255,215,175);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;font-weight:700;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(255,215,175);">███████</span></span><span style="color:rgb(0,0,0);background-color:rgb(255,215,175);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;">26.7%</span><span style="color:rgb(255,215,175);background-color:rgb(255,215,175);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;font-weight:700;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(255,215,175);">███████</span></span><span style="color:rgb(175,175,95);background-color:rgb(175,175,95);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;font-weight:700;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(175,175,95);">██████</span></span><span style="color:rgb(0,0,0);background-color:rgb(175,175,95);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;">23.3%</span><span style="color:rgb(175,175,95);background-color:rgb(175,175,95);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;font-weight:700;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(175,175,95);">██████</span></span><span style="color:rgb(135,175,135);background-color:rgb(135,175,135);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;font-weight:700;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(135,175,135);">████</span></span><span style="color:rgb(0,0,0);background-color:rgb(135,175,135);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;">20.0%</span><span style="color:rgb(135,175,135);background-color:rgb(135,175,135);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;font-weight:700;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(135,175,135);">█████</span></span><span style="color:rgb(135,175,135);background-color:rgb(135,175,135);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(135,175,135);">████</span></span><span style="color:rgb(0,0,0);background-color:rgb(135,175,135);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;">17.8%</span><span style="color:rgb(135,175,135);background-color:rgb(135,175,135);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(135,175,135);">████</span></span><span style="color:rgb(175,175,0);background-color:rgb(175,175,0);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(175,175,0);">██</span></span><span style="color:rgb(0,0,0);background-color:rgb(175,175,0);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;">12.2%</span><span style="color:rgb(175,175,0);background-color:rgb(175,175,0);display:inline-block;height:1lh;line-height:1lh;vertical-align:top;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(175,175,0);">██</span></span></span></span>
<span class="mdf-line mdf-chart-line" style="display:block;white-space:pre;overflow-wrap:normal;text-align:center;"><span class="mdf-prefix"></span><span class="mdf-content" style="display:inline-block;white-space:pre;overflow-wrap:normal;text-align:left;"><span style="color:rgb(255,215,175);font-weight:700;">■</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(255,215,175);font-weight:700;">Tests</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(255,215,175);font-weight:700;">24</span><span style="color:rgb(220,220,220);">  </span><span style="color:rgb(175,175,95);font-weight:700;">■</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(175,175,95);font-weight:700;">HTML</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(175,175,95);font-weight:700;">21</span><span style="color:rgb(220,220,220);">  </span><span style="color:rgb(135,175,135);font-weight:700;">■</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(135,175,135);font-weight:700;">Deck</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(135,175,135);font-weight:700;">18</span><span style="color:rgb(220,220,220);">  </span><span style="color:rgb(135,175,135);">■</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(135,175,135);">CLI</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(135,175,135);">16</span><span style="color:rgb(220,220,220);">  </span><span style="color:rgb(175,175,0);">■</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(175,175,0);">Lua</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(175,175,0);">11</span></span></span></span></div></div></div></div></section>
</main>
<script>
(function(){'use strict';
var deck=document.querySelector('.mdf-deck');if(!deck)return;
var slides=[].slice.call(deck.querySelectorAll('.mdf-slide'));var last=0;var cur=0;
var focusable='a[href],area[href],button,input,select,textarea,iframe,object,embed,[tabindex],details>summary';
var fs=deck.querySelector('.mdf-fullscreen-button');var reduceMotion=!!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches);function refit(){setTimeout(function(){fit(slides[cur]);},60);}
var cursorTimer=0;function showCursor(){deck.classList.remove('mdf-cursor-hidden');clearTimeout(cursorTimer);cursorTimer=setTimeout(function(){deck.classList.add('mdf-cursor-hidden');},2500);}showCursor();
function toggleFullscreen(){var el=deck;var req=el.requestFullscreen||el.webkitRequestFullscreen;
var exit=document.exitFullscreen||document.webkitExitFullscreen;if(document.fullscreenElement||document.webkitFullscreenElement){if(exit)exit.call(document);else deck.classList.remove('mdf-fallback-fullscreen');refit();return;}
if(req){var p=req.call(el);if(p&&p.catch)p.catch(function(){deck.classList.toggle('mdf-fallback-fullscreen');refit();});else refit();}else{deck.classList.toggle('mdf-fallback-fullscreen');refit();}}
function fit(slide){var box=slide.querySelector('.mdf-slide-content');if(!box)return;
var vw=Math.max(320,innerWidth||document.documentElement.clientWidth||1024);
var vh=Math.max(320,innerHeight||document.documentElement.clientHeight||768);
var dense=box.textContent.length>520;var scale=Math.min(vw,vh);var base=scale*(slide.classList.contains('mdf-slide-front') ? .072 : (dense ? .038 : .047));
if(vw<640)base=scale*(slide.classList.contains('mdf-slide-front') ? .087 : (dense ? .046 : .056));
if(vh<520)base=scale*(slide.classList.contains('mdf-slide-front') ? .077 : (dense ? .041 : .051));
var hasChart=!!box.querySelector('.mdf-chart-block');var min=vw<640?(hasChart?8:12):14;
if(vh<520)min=hasChart?8:12;var body=box.querySelector('.mdf-slide-body');var inner=box.querySelector('.mdf-slide-body-inner');var size=Math.max(min,Math.round(base));
box.style.setProperty('--mdf-slide-font-size',size+'px');
for(;size>min;size-=1){box.style.setProperty('--mdf-slide-font-size',size+'px');
if(box.scrollHeight<=box.clientHeight+4&&box.scrollWidth<=box.clientWidth+4&&(!inner||(inner.scrollHeight<=body.clientHeight+4&&inner.scrollWidth<=body.clientWidth+4)))break;}
box.classList.toggle('mdf-slide-scroll-fallback',box.scrollHeight>box.clientHeight+4||box.scrollWidth>box.clientWidth+4||(inner&&(inner.scrollHeight>body.clientHeight+4||inner.scrollWidth>body.clientWidth+4)));}
function syncSlides(){slides.forEach(function(s,i){var active=i===cur;
s.setAttribute('aria-hidden',active?'false':'true');if('inert'in s)s.inert=!active;
[].slice.call(s.querySelectorAll(focusable)).forEach(function(el){if(active){
if(el.hasAttribute('data-mdf-tabindex')){var v=el.getAttribute('data-mdf-tabindex');el.removeAttribute('data-mdf-tabindex');if(v==='')el.removeAttribute('tabindex');else el.setAttribute('tabindex',v);}}
else{if(!el.hasAttribute('data-mdf-tabindex'))el.setAttribute('data-mdf-tabindex',el.hasAttribute('tabindex')?el.getAttribute('tabindex'):'');el.setAttribute('tabindex','-1');}});});deck.dataset.current=String(cur+1);}
function show(n,remember){if(n<0)n=0;if(n>=slides.length)n=slides.length-1;if(n===cur)return;
if(remember)last=cur;var old=cur;cur=n;function apply(){syncSlides();
location.hash='slide-'+String(cur+1);fit(slides[cur]);}
if(deck.dataset.transition==='fade'&&!reduceMotion&&old!==cur){deck.classList.add('mdf-blackout');
setTimeout(function(){apply();void deck.offsetWidth;deck.classList.remove('mdf-blackout');},520);}else{apply();}}
function fromHash(){var m=/^#slide-(\d+)$/.exec(location.hash);if(m){
cur=Math.max(0,Math.min(slides.length-1,parseInt(m[1],10)-1));}}
fromHash();syncSlides();
var w=String(slides.length).length;if(w<2)w=2;slides.forEach(function(s,i){
var n=s.querySelector('.mdf-slide-number');if(n)n.textContent=String(i+1).padStart(w,'0')+'/'+String(slides.length).padStart(w,'0');});
fit(slides[cur]);addEventListener('resize',function(){fit(slides[cur]);});
addEventListener('pointermove',showCursor,{passive:true});addEventListener('mousemove',showCursor,{passive:true});
if(fs)fs.addEventListener('click',toggleFullscreen);
document.addEventListener('fullscreenchange',refit);document.addEventListener('webkitfullscreenchange',refit);
addEventListener('hashchange',function(){var before=cur;fromHash();if(before!==cur){
syncSlides();fit(slides[cur]);}});
document.addEventListener('keydown',function(e){if(e.altKey||e.ctrlKey||e.metaKey)return;
var t=e.target;if(t&&(t.isContentEditable||(t.closest&&t.closest('a[href],button,summary,input,select,textarea'))))return;
switch(e.key){case'ArrowRight':case'ArrowDown':case'PageDown':case' ':case'j':
e.preventDefault();show(cur+1,true);break;case'ArrowLeft':case'ArrowUp':case'PageUp':case'k':
e.preventDefault();show(cur-1,true);break;case'Home':case'g':e.preventDefault();show(0,true);break;
case'End':case'G':e.preventDefault();show(slides.length-1,true);break;
case'f':e.preventDefault();toggleFullscreen();break;
case'o':e.preventDefault();show(last,false);break;}});
var sx=0,sy=0,swiping=false;deck.addEventListener('touchstart',function(e){
if(e.touches.length!==1)return;var t=e.touches[0];sx=t.clientX;sy=t.clientY;swiping=true;},{passive:true});
deck.addEventListener('touchend',function(e){if(!swiping)return;swiping=false;
var t=e.changedTouches&&e.changedTouches[0];if(!t)return;var dx=t.clientX-sx;var dy=t.clientY-sy;
var box=slides[cur]&&slides[cur].querySelector('.mdf-slide-content');
if(Math.abs(dx)>=48&&Math.abs(dx)>=Math.abs(dy)*1.4){if(dx<0)show(cur+1,true);else show(cur-1,true);return;}
if(Math.abs(dy)<48||Math.abs(dy)<Math.abs(dx)*1.4)return;
if(box&&box.scrollHeight>box.clientHeight+4){if(dy<0&&box.scrollTop+box.clientHeight<box.scrollHeight-4)return;
if(dy>0&&box.scrollTop>1)return;}if(dy<0)show(cur+1,true);else show(cur-1,true);},{passive:true});})();
</script>
</body>
</html>
