<title>libmdf Deck Mode</title>
<style>
:root{color-scheme:dark light;}
html,body{margin:0;min-height:100%;background:rgb(0,0,0);}
body{color:rgb(220,220,220);font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono","Courier New",monospace;font-size:12pt;line-height:1.4;}
.mdf-document{--mdf-content-max-width:96ch;--mdf-page-padding-block:36pt;--mdf-page-padding-inline:36pt;box-sizing:border-box;min-height:100vh;width:min(100%,var(--mdf-content-max-width));margin-inline:auto;padding-block:var(--mdf-page-padding-block);padding-inline:clamp(1rem,4vw,var(--mdf-page-padding-inline));white-space:pre-wrap;overflow-wrap:anywhere;tab-size:4;}
