<span class="mdf-line mdf-chart-line" style="display:block;white-space:pre;overflow-wrap:normal;text-align:center;"><span class="mdf-prefix"></span><span class="mdf-content" style="display:inline-block;white-space:pre;overflow-wrap:normal;text-align:left;"><span style="color:rgb(255,175,215);font-weight:700;">■</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(255,175,215);font-weight:700;">Renderer</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(255,175,215);font-weight:700;">34</span><span style="color:rgb(220,220,220);">  </span><span style="color:rgb(135,175,255);font-weight:700;">■</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(135,175,255);font-weight:700;">Tests</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(135,175,255);font-weight:700;">27</span><span style="color:rgb(220,220,220);">  </span><span style="color:rgb(135,175,215);font-weight:700;">■</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(135,175,215);font-weight:700;">Parser</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(135,175,215);font-weight:700;">21</span><span style="color:rgb(220,220,220);">  </span><span style="color:rgb(215,135,215);">■</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(215,135,215);">CLI</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(215,135,215);">18</span></span></span></span></div></div></div></div></section>
<section class="mdf-slide" data-slide="18" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Chart In Quote</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><div class="mdf-chart-block" style="width:100%;text-align:center;"><span class="mdf-chart-box" style="display:inline-block;text-align:left;"><span class="mdf-line mdf-chart-line" style="white-space:pre;overflow-wrap:normal;text-align:left;"><span class="mdf-prefix"></span><span class="mdf-content" style="white-space:pre;overflow-wrap:normal;text-align:left;"><span style="color:rgb(135,175,215);font-weight:700;">Explicit</span><span style="color:rgb(127,127,127);"> <span style="display:inline-block;width:1ch;height:1lh;line-height:1lh;vertical-align:top;color:inherit;-webkit-text-fill-color:transparent;background:linear-gradient(to right,transparent calc(50% - .045em),currentColor calc(50% - .045em),currentColor calc(50% + .045em),transparent calc(50% + .045em));">│</span> </span><span style="color:rgb(135,175,215);font-weight:700;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(135,175,215);">████████████████████████████</span></span><span style="color:rgb(220,220,220);">          </span><span style="color:rgb(135,175,215);font-weight:700;">40 40.0%</span></span></span>
<span class="mdf-line mdf-chart-line" style="white-space:pre;overflow-wrap:normal;text-align:left;"><span class="mdf-prefix"></span><span class="mdf-content" style="white-space:pre;overflow-wrap:normal;text-align:left;"><span style="color:rgb(135,175,215);font-weight:700;">Magic</span><span style="color:rgb(220,220,220);">   </span><span style="color:rgb(127,127,127);"> <span style="display:inline-block;width:1ch;height:1lh;line-height:1lh;vertical-align:top;color:inherit;-webkit-text-fill-color:transparent;background:linear-gradient(to right,transparent calc(50% - .045em),currentColor calc(50% - .045em),currentColor calc(50% + .045em),transparent calc(50% + .045em));">│</span> </span><span style="color:rgb(135,175,215);font-weight:700;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(135,175,215);">█████</span></span><span style="color:rgb(220,220,220);">                                 </span><span style="color:rgb(135,175,215);font-weight:700;">7 7.0%</span></span></span>
<span class="mdf-line mdf-chart-line" style="white-space:pre;overflow-wrap:normal;text-align:left;"><span class="mdf-prefix"></span><span class="mdf-content" style="white-space:pre;overflow-wrap:normal;text-align:left;"><span style="color:rgb(135,175,215);font-weight:700;">Evidence</span><span style="color:rgb(127,127,127);"> <span style="display:inline-block;width:1ch;height:1lh;line-height:1lh;vertical-align:top;color:inherit;-webkit-text-fill-color:transparent;background:linear-gradient(to right,transparent calc(50% - .045em),currentColor calc(50% - .045em),currentColor calc(50% + .045em),transparent calc(50% + .045em));">│</span> </span><span style="color:rgb(135,175,215);font-weight:700;"><span style="display:inline-block;height:1lh;line-height:1lh;vertical-align:top;white-space:pre;color:transparent;background-color:rgb(135,175,215);">█████████████████████████████████████</span></span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(135,175,215);font-weight:700;">53 53.0%</span></span></span>
</span></div>
<span style="color:rgb(220,220,220);">Quoted charts should inherit the surrounding container treatment without breaking chart layout.</span></div></div></div></section>
<section class="mdf-slide" data-slide="19" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Mixed Technical Slide</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span class="mdf-heading" style="color:rgb(135,175,255);font-weight:700;font-size:22pt;font-weight:700;--mdf-heading-indent:3ch;">## Release Checklist</span><span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,175,215);">1.</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(220,220,220);">API options initialized by </span><span style="color:rgb(95,135,175);">mdf_options_init</span><span style="color:rgb(220,220,220);">.</span></span></span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,175,215);">2.</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(220,220,220);">CLI validates </span><span style="color:rgb(95,135,175);">--transition</span><span style="color:rgb(220,220,220);"> before rendering.</span></span></span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,175,215);">3.</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(95,135,175);">MDF_FORMAT_HTML</span><span style="color:rgb(220,220,220);"> output remains unchanged.</span></span></span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,175,215);">4.</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(95,135,175);">MDF_FORMAT_HTML_DECK</span><span style="color:rgb(220,220,220);"> emits deck shell, CSS, and JavaScript.</span></span></span>

<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(78,78,78);">&gt;</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(175,215,255);">The deck renderer may materialize one slide at a time, but ordinary HTML mode</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(175,215,255);">should not inherit deck-only behavior.</span></span></span></div></div></div></section>
<section class="mdf-slide" data-slide="20" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Thematic Break Edge Cases</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span style="color:rgb(220,220,220);">The next fenced block contains a line that looks like a slide separator:</span>

<span style="color:rgb(95,95,255);">Paragraph before a thematic break.</span>
<span style="color:rgb(95,95,255);">---</span>
<span style="color:rgb(95,95,255);">Paragraph after a thematic break inside an example.</span>

<span style="color:rgb(220,220,220);">The deck must keep this entire fenced block on one slide.</span></div></div></div></section>
<section class="mdf-slide" data-slide="21" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Quoted Thematic Break</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(78,78,78);">&gt;</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(175,215,255);">This quote contains a thematic-looking line:</span></span></span>
<span style="color:rgb(78,78,78);">&gt;</span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(78,78,78);">&gt;</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(175,215,255);">---</span></span></span>
<span style="color:rgb(78,78,78);">&gt;</span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(78,78,78);">&gt;</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(175,215,255);">It is quoted content and should remain on the current slide.</span></span></span>

<span style="color:rgb(220,220,220);">The actual slide separator is the unquoted thematic break after this slide.</span></div></div></div></section>
<section class="mdf-slide" data-slide="22" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># List Thematic Break</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,175,215);">-</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(220,220,220);">List item before an indented thematic-looking line.</span></span></span>

<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(220,220,220);">  </span></span><span class="mdf-content"><span style="color:rgb(220,220,220);">---</span></span></span>

<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,175,215);">-</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(220,220,220);">List item after the indented line.</span></span></span>

<span style="color:rgb(220,220,220);">The indented line belongs to the list context and should not split slides unless the Markdown parser classifies it as a block-level thematic break outside the container.</span></div></div></div></section>
<section class="mdf-slide" data-slide="23" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Raw HTML</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span style="color:rgb(220,220,220);">&lt;p data-deck-fixture=&#34;raw-html&#34;&gt;Raw inline HTML is escaped and rendered as text according to existing HTML renderer rules.&lt;/p&gt;</span>

<span style="color:rgb(220,220,220);">&lt;details&gt; &lt;summary&gt;Disclosure content&lt;/summary&gt; This is intentionally shown as escaped text rather than a live disclosure. &lt;/details&gt;</span></div></div></div></section>
<section class="mdf-slide" data-slide="24" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Links And Interaction</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><a href="https://example.com/docs" target="_blank" rel="noopener noreferrer"><span style="color:rgb(135,175,215);font-weight:700;text-decoration:underline;">Primary documentation link</span></a>

<a href="https://example.com/docs/deck/mode/long/link" target="_blank" rel="noopener noreferrer"><span style="color:rgb(135,175,215);font-weight:700;text-decoration:underline;">A longer link label that wraps across lines in narrow viewports</span></a>

<span style="color:rgb(220,220,220);">Link activation should not accidentally advance the deck. Focus should remain usable on the current slide only.</span></div></div></div></section>
<section class="mdf-slide" data-slide="25" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Image Syntax</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span style="color:rgb(220,220,220);">!</span><span style="color:rgb(135,175,215);font-weight:700;text-decoration:underline;">Tiny transparent pixel</span>

<span style="color:rgb(220,220,220);">This exercises Markdown image output without requiring network access. The image is intentionally tiny so it does not dominate the slide.</span></div></div></div></section>
<section class="mdf-slide" data-slide="26" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Long Word Pressure</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span style="color:rgb(220,220,220);">The renderer should avoid layout explosions from a long token:</span>

<span style="color:rgb(95,135,175);">supercalifragilisticexpialidocious-supercalifragilisticexpialidocious-supercalifragilisticexpialidocious</span>

<span style="color:rgb(220,220,220);">Normal prose after the long token should remain visible.</span></div></div></div></section>
<section class="mdf-slide" data-slide="27" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Escapes And Entity Text</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span style="color:rgb(220,220,220);">Escaped punctuation should remain readable as literal text: </span><span style="color:rgb(95,135,175);">*not emphasis*</span><span style="color:rgb(220,220,220);">, </span><span style="color:rgb(95,135,175);">[not a link]</span><span style="color:rgb(220,220,220);">, and </span><span style="color:rgb(95,135,175);"># not a heading</span><span style="color:rgb(220,220,220);">.</span>

<span style="color:rgb(220,220,220);">Entity-looking text should also remain readable: </span><span style="color:rgb(95,135,175);">AT&amp;amp;T</span><span style="color:rgb(220,220,220);">, </span><span style="color:rgb(95,135,175);">&amp;lt;tag&amp;gt;</span><span style="color:rgb(220,220,220);">, and </span><span style="color:rgb(95,135,175);">10&amp;nbsp;000</span><span style="color:rgb(220,220,220);">.</span></div></div></div></section>
<section class="mdf-slide" data-slide="28" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(135,175,255);font-weight:700;font-size:22pt;font-weight:700;--mdf-heading-indent:3ch;">## Second-Level Slide Header</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span style="color:rgb(220,220,220);">This slide starts with a </span><span style="color:rgb(95,135,175);">##</span><span style="color:rgb(220,220,220);"> ATX heading instead of </span><span style="color:rgb(95,135,175);">#</span><span style="color:rgb(220,220,220);">. The deck renderer should still treat it as the slide header and keep the body content below it.</span></div></div></div></section>
<section class="mdf-slide" data-slide="29" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(135,175,215);font-weight:700;font-size:15pt;font-weight:700;--mdf-heading-indent:4ch;">### Third-Level Slide Header</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span style="color:rgb(220,220,220);">This slide starts with a </span><span style="color:rgb(95,135,175);">###</span><span style="color:rgb(220,220,220);"> ATX heading. It verifies that lower-level first headings can act as slide headers without inheriting body centering behavior.</span></div></div></div></section>
<section class="mdf-slide" data-slide="30" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Final Slide</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span class="mdf-heading" style="color:rgb(135,175,255);font-weight:700;font-size:22pt;font-weight:700;--mdf-heading-indent:3ch;">## End State</span><span style="color:rgb(220,220,220);">This slide verifies </span><span style="color:rgb(95,135,175);">End</span><span style="color:rgb(220,220,220);">, </span><span style="color:rgb(95,135,175);">G</span><span style="color:rgb(220,220,220);">, URL hash restoration, and slide number rendering near the end of the deck.</span></div></div></div></section>
</main>
<script>
(function(){'use strict';
var deck=document.querySelector('.mdf-deck');if(!deck)return;
var slides=[].slice.call(deck.querySelectorAll('.mdf-slide'));var last=0;var cur=0;
var focusable='a[href],area[href],button,input,select,textarea,iframe,object,embed,[tabindex],details>summary';
var fs=deck.querySelector('.mdf-fullscreen-button');var reduceMotion=!!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches);function refit(){setTimeout(function(){fit(slides[cur]);},60);}
var cursorTimer=0;function showCursor(){deck.classList.remove('mdf-cursor-hidden');clearTimeout(cursorTimer);cursorTimer=setTimeout(function(){deck.classList.add('mdf-cursor-hidden');},2500);}showCursor();
function toggleFullscreen(){var el=deck;var req=el.requestFullscreen||el.webkitRequestFullscreen;
var exit=document.exitFullscreen||document.webkitExitFullscreen;if(document.fullscreenElement||document.webkitFullscreenElement){if(exit)exit.call(document);else deck.classList.remove('mdf-fallback-fullscreen');refit();return;}
if(req){var p=req.call(el);if(p&&p.catch)p.catch(function(){deck.classList.toggle('mdf-fallback-fullscreen');refit();});else refit();}else{deck.classList.toggle('mdf-fallback-fullscreen');refit();}}
function fit(slide){var box=slide.querySelector('.mdf-slide-content');if(!box)return;
var vw=Math.max(320,innerWidth||document.documentElement.clientWidth||1024);
var vh=Math.max(320,innerHeight||document.documentElement.clientHeight||768);
var dense=box.textContent.length>520;var scale=Math.min(vw,vh);var base=scale*(slide.classList.contains('mdf-slide-front') ? .072 : (dense ? .038 : .047));
if(vw<640)base=scale*(slide.classList.contains('mdf-slide-front') ? .087 : (dense ? .046 : .056));
if(vh<520)base=scale*(slide.classList.contains('mdf-slide-front') ? .077 : (dense ? .041 : .051));
var hasChart=!!box.querySelector('.mdf-chart-block');var min=vw<640?(hasChart?8:12):14;
if(vh<520)min=hasChart?8:12;var body=box.querySelector('.mdf-slide-body');var inner=box.querySelector('.mdf-slide-body-inner');var size=Math.max(min,Math.round(base));
box.style.setProperty('--mdf-slide-font-size',size+'px');
for(;size>min;size-=1){box.style.setProperty('--mdf-slide-font-size',size+'px');
if(box.scrollHeight<=box.clientHeight+4&&box.scrollWidth<=box.clientWidth+4&&(!inner||(inner.scrollHeight<=body.clientHeight+4&&inner.scrollWidth<=body.clientWidth+4)))break;}
box.classList.toggle('mdf-slide-scroll-fallback',box.scrollHeight>box.clientHeight+4||box.scrollWidth>box.clientWidth+4||(inner&&(inner.scrollHeight>body.clientHeight+4||inner.scrollWidth>body.clientWidth+4)));}
function syncSlides(){slides.forEach(function(s,i){var active=i===cur;
s.setAttribute('aria-hidden',active?'false':'true');if('inert'in s)s.inert=!active;
[].slice.call(s.querySelectorAll(focusable)).forEach(function(el){if(active){
if(el.hasAttribute('data-mdf-tabindex')){var v=el.getAttribute('data-mdf-tabindex');el.removeAttribute('data-mdf-tabindex');if(v==='')el.removeAttribute('tabindex');else el.setAttribute('tabindex',v);}}
else{if(!el.hasAttribute('data-mdf-tabindex'))el.setAttribute('data-mdf-tabindex',el.hasAttribute('tabindex')?el.getAttribute('tabindex'):'');el.setAttribute('tabindex','-1');}});});deck.dataset.current=String(cur+1);}
function show(n,remember){if(n<0)n=0;if(n>=slides.length)n=slides.length-1;if(n===cur)return;
if(remember)last=cur;var old=cur;cur=n;function apply(){syncSlides();
location.hash='slide-'+String(cur+1);fit(slides[cur]);}
if(deck.dataset.transition==='fade'&&!reduceMotion&&old!==cur){deck.classList.add('mdf-blackout');
setTimeout(function(){apply();void deck.offsetWidth;deck.classList.remove('mdf-blackout');},520);}else{apply();}}
function fromHash(){var m=/^#slide-(\d+)$/.exec(location.hash);if(m){
cur=Math.max(0,Math.min(slides.length-1,parseInt(m[1],10)-1));}}
fromHash();syncSlides();
var w=String(slides.length).length;if(w<2)w=2;slides.forEach(function(s,i){
var n=s.querySelector('.mdf-slide-number');if(n)n.textContent=String(i+1).padStart(w,'0')+'/'+String(slides.length).padStart(w,'0');});
fit(slides[cur]);addEventListener('resize',function(){fit(slides[cur]);});
addEventListener('pointermove',showCursor,{passive:true});addEventListener('mousemove',showCursor,{passive:true});
if(fs)fs.addEventListener('click',toggleFullscreen);
document.addEventListener('fullscreenchange',refit);document.addEventListener('webkitfullscreenchange',refit);
addEventListener('hashchange',function(){var before=cur;fromHash();if(before!==cur){
syncSlides();fit(slides[cur]);}});
document.addEventListener('keydown',function(e){if(e.altKey||e.ctrlKey||e.metaKey)return;
var t=e.target;if(t&&(t.isContentEditable||(t.closest&&t.closest('a[href],button,summary,input,select,textarea'))))return;
switch(e.key){case'ArrowRight':case'ArrowDown':case'PageDown':case' ':case'j':
e.preventDefault();show(cur+1,true);break;case'ArrowLeft':case'ArrowUp':case'PageUp':case'k':
e.preventDefault();show(cur-1,true);break;case'Home':case'g':e.preventDefault();show(0,true);break;
case'End':case'G':e.preventDefault();show(slides.length-1,true);break;
case'f':e.preventDefault();toggleFullscreen();break;
case'o':e.preventDefault();show(last,false);break;}});
var sx=0,sy=0,swiping=false;deck.addEventListener('touchstart',function(e){
if(e.touches.length!==1)return;var t=e.touches[0];sx=t.clientX;sy=t.clientY;swiping=true;},{passive:true});
deck.addEventListener('touchend',function(e){if(!swiping)return;swiping=false;
var t=e.changedTouches&&e.changedTouches[0];if(!t)return;var dx=t.clientX-sx;var dy=t.clientY-sy;
var box=slides[cur]&&slides[cur].querySelector('.mdf-slide-content');
if(Math.abs(dx)>=48&&Math.abs(dx)>=Math.abs(dy)*1.4){if(dx<0)show(cur+1,true);else show(cur-1,true);return;}
if(Math.abs(dy)<48||Math.abs(dy)<Math.abs(dx)*1.4)return;
if(box&&box.scrollHeight>box.clientHeight+4){if(dy<0&&box.scrollTop+box.clientHeight<box.scrollHeight-4)return;
if(dy>0&&box.scrollTop>1)return;}if(dy<0)show(cur+1,true);else show(cur-1,true);},{passive:true});})();
</script>
</body>
</html>
