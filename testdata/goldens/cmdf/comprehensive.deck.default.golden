<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>libmdf Deck Mode</title>
<style>
@font-face{font-family:"JetBrains Mono";src:url(data:font/woff2;base64,) format('woff2');font-weight:400;font-style:normal;font-display:block;}
@font-face{font-family:"JetBrains Mono";src:url(data:font/woff2;base64,) format('woff2');font-weight:700;font-style:normal;font-display:block;}
@font-face{font-family:"JetBrains Mono";src:url(data:font/woff2;base64,) format('woff2');font-weight:400;font-style:italic;font-display:block;}
@font-face{font-family:"JetBrains Mono";src:url(data:font/woff2;base64,) format('woff2');font-weight:700;font-style:italic;font-display:block;}
:root{color-scheme:dark light;}
html,body{margin:0;min-height:100%;background:rgb(0,0,0);}
body{color:rgb(220,220,220);font-family:"JetBrains Mono",monospace;font-size:12pt;line-height:1.4;}
.mdf-document{--mdf-content-max-width:96ch;--mdf-page-padding-block:36pt;--mdf-page-padding-inline:36pt;box-sizing:border-box;min-height:100vh;width:min(100%,var(--mdf-content-max-width));margin-inline:auto;padding-block:var(--mdf-page-padding-block);padding-inline:clamp(1rem,4vw,var(--mdf-page-padding-inline));white-space:pre-wrap;overflow-wrap:anywhere;tab-size:4;}
.mdf-document a{color:inherit;text-decoration:none;}
.mdf-document a:hover{text-decoration:underline;}
.mdf-heading{display:inline-block;box-sizing:border-box;max-width:100%;white-space:normal;overflow-wrap:anywhere;padding-left:var(--mdf-heading-indent);text-indent:calc(-1 * var(--mdf-heading-indent));vertical-align:top;}
.mdf-line{display:inline-grid;grid-template-columns:max-content minmax(0,1fr);max-width:100%;white-space:normal;overflow-wrap:anywhere;vertical-align:top;}
.mdf-prefix{grid-column:1;white-space:pre;}
.mdf-content{grid-column:2;min-width:0;white-space:pre-wrap;overflow-wrap:anywhere;}
.mdf-table-block{display:grid;grid-template-columns:max-content max-content;column-gap:0;align-items:start;margin:1em 0;clear:both;}
.mdf-table-block .mdf-table{margin:0;}
.mdf-corner-image{float:right;max-width:96pt;max-height:96pt;margin-left:8pt;margin-bottom:8pt;object-fit:contain;}
.mdf-table{--mdf-table-wire:rgb(127,127,127);white-space:normal;border-collapse:collapse;margin:1em 0;clear:both;}
.mdf-table th,.mdf-table td{vertical-align:top;overflow-wrap:anywhere;white-space:pre-wrap;}
.mdf-table th{color:rgb(135,215,255);font-weight:700;overflow-wrap:normal;word-break:normal;}
.mdf-table-bordered th,.mdf-table-bordered td{border:1px solid var(--mdf-table-wire);padding:.2em 1ch;}
.mdf-table-space{border-collapse:collapse;border-spacing:0;}
.mdf-table-space th,.mdf-table-space td{border:0;padding:0 1ch;}
.mdf-table-space th:first-child,.mdf-table-space td:first-child{padding-left:0;}
.mdf-table-space th:last-child,.mdf-table-space td:last-child{padding-right:0;}

html,body{width:100%;height:100%;overflow:hidden;}
body{background:#000;}
.mdf-deck{position:relative;width:100vw;height:100vh;overflow:hidden;background:#000;}
.mdf-deck.mdf-cursor-hidden,.mdf-deck.mdf-cursor-hidden *{cursor:none!important;}
.mdf-slide{position:absolute;inset:0;box-sizing:border-box;padding:clamp(18px,4vw,72px);display:grid;align-items:start;justify-items:stretch;opacity:0;visibility:hidden;pointer-events:none;background:inherit;color:inherit;}
.mdf-slide{transition:opacity 140ms ease,visibility 0s linear 140ms;}
.mdf-slide[aria-hidden="false"]{opacity:1;visibility:visible;pointer-events:auto;transition:opacity 140ms ease;}
.mdf-slide-front{align-items:center;justify-items:center;text-align:left;}
.mdf-slide-front .mdf-slide-content{max-width:min(88vw,80ch);text-align:left;}
.mdf-slide-front.mdf-center-front-text .mdf-slide-content{text-align:center;}
.mdf-slide-content{box-sizing:border-box;width:min(100%,92vw,var(--mdf-content-max-width,96ch));max-width:100%;}
.mdf-slide-content{max-height:calc(100vh - clamp(104px,12vw,160px));overflow:auto;white-space:pre-wrap;}
.mdf-slide-content{padding-bottom:clamp(48px,8vh,72px);}
.mdf-slide-front .mdf-slide-content{width:max-content;max-width:min(88vw,80ch);max-height:none;overflow:visible;padding-bottom:0;}
.mdf-slide-content{overflow-wrap:anywhere;tab-size:4;font-size:var(--mdf-slide-font-size,1.6rem);line-height:1.35;}
.mdf-slide-content-centered{height:calc(100vh - clamp(104px,12vw,160px));display:flex;flex-direction:column;}
.mdf-slide-content-centered .mdf-slide-header{flex:0 0 auto;}
.mdf-slide-content-centered .mdf-slide-header .mdf-heading{display:block;margin:0 0 .5em;}
.mdf-slide-content-centered .mdf-slide-body{flex:1 1 auto;min-height:0;min-width:0;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;}
.mdf-slide-content-centered:has(.mdf-chart-block){width:100%;}
.mdf-slide-body-inner{flex:0 0 auto;width:100%;min-width:0;max-width:100%;}
.mdf-slide-content-centered.mdf-slide-scroll-fallback .mdf-slide-body{justify-content:flex-start;}
.mdf-slide-body-inner>.mdf-heading+br,.mdf-slide-body-inner>.mdf-heading+br+br{display:none;}
.mdf-slide-body-inner>.mdf-heading{display:block;margin:0 0 .45em;}
.mdf-slide-body-inner>.mdf-heading~.mdf-heading{margin-top:.8em;}
.mdf-slide-content .mdf-heading{line-height:1.12;}
.mdf-slide-header .mdf-heading[style*="font-size:32pt"],.mdf-slide-front .mdf-heading[style*="font-size:32pt"]{font-size:min(7.4vmin,7vw)!important;}
.mdf-slide-header .mdf-heading[style*="font-size:22pt"],.mdf-slide-front .mdf-heading[style*="font-size:22pt"]{font-size:min(6.8vmin,6.4vw)!important;}
.mdf-slide-header .mdf-heading[style*="font-size:15pt"],.mdf-slide-front .mdf-heading[style*="font-size:15pt"]{font-size:min(6.2vmin,5.8vw)!important;}
.mdf-slide-header .mdf-heading[style*="--mdf-heading-indent:5ch"],.mdf-slide-front .mdf-heading[style*="--mdf-heading-indent:5ch"]{font-size:min(5.7vmin,5.3vw)!important;}
.mdf-slide-header .mdf-heading[style*="--mdf-heading-indent:6ch"],.mdf-slide-front .mdf-heading[style*="--mdf-heading-indent:6ch"]{font-size:min(5.2vmin,4.8vw)!important;}
.mdf-slide-header .mdf-heading[style*="--mdf-heading-indent:7ch"],.mdf-slide-front .mdf-heading[style*="--mdf-heading-indent:7ch"]{font-size:min(4.8vmin,4.4vw)!important;}
.mdf-slide-body .mdf-heading[style*="font-size:32pt"]{font-size:1.55em!important;}
.mdf-slide-body .mdf-heading[style*="font-size:22pt"]{font-size:1.35em!important;}
.mdf-slide-body .mdf-heading[style*="font-size:15pt"]{font-size:1.2em!important;}
.mdf-slide-body .mdf-heading[style*="--mdf-heading-indent:5ch"]{font-size:1.1em!important;}
.mdf-slide-body .mdf-heading[style*="--mdf-heading-indent:6ch"]{font-size:1.05em!important;}
.mdf-slide-body .mdf-heading[style*="--mdf-heading-indent:7ch"]{font-size:1em!important;}
@media (max-width:640px){.mdf-slide-header .mdf-heading[style*="font-size:32pt"],.mdf-slide-front .mdf-heading[style*="font-size:32pt"]{font-size:clamp(1.9rem,8vw,32pt)!important;}.mdf-slide-header .mdf-heading[style*="font-size:22pt"],.mdf-slide-front .mdf-heading[style*="font-size:22pt"]{font-size:clamp(1.75rem,7.4vw,36pt)!important;}.mdf-slide-header .mdf-heading[style*="font-size:15pt"],.mdf-slide-front .mdf-heading[style*="font-size:15pt"]{font-size:clamp(1.6rem,6.8vw,32pt)!important;}.mdf-slide-header .mdf-heading[style*="--mdf-heading-indent:5ch"],.mdf-slide-front .mdf-heading[style*="--mdf-heading-indent:5ch"]{font-size:clamp(1.45rem,6.2vw,28pt)!important;}.mdf-slide-header .mdf-heading[style*="--mdf-heading-indent:6ch"],.mdf-slide-front .mdf-heading[style*="--mdf-heading-indent:6ch"]{font-size:clamp(1.32rem,5.7vw,24pt)!important;}.mdf-slide-header .mdf-heading[style*="--mdf-heading-indent:7ch"],.mdf-slide-front .mdf-heading[style*="--mdf-heading-indent:7ch"]{font-size:clamp(1.2rem,5.2vw,21pt)!important;}.mdf-slide-body .mdf-heading[style*="font-size:32pt"]{font-size:1.55em!important;}.mdf-slide-body .mdf-heading[style*="font-size:22pt"]{font-size:1.35em!important;}.mdf-slide-body .mdf-heading[style*="font-size:15pt"]{font-size:1.2em!important;}.mdf-slide-body .mdf-heading[style*="--mdf-heading-indent:5ch"]{font-size:1.1em!important;}.mdf-slide-body .mdf-heading[style*="--mdf-heading-indent:6ch"]{font-size:1.05em!important;}.mdf-slide-body .mdf-heading[style*="--mdf-heading-indent:7ch"]{font-size:1em!important;}}
.mdf-slide-content .mdf-table{font-size:.86em;}
.mdf-slide-content .mdf-chart-block{font-size:.82em;}
@media (max-height:520px){.mdf-slide-content{max-height:calc(100vh - 112px);}}
.mdf-slide-number{position:absolute;right:clamp(16px,3vw,40px);bottom:clamp(14px,3vw,34px);}
.mdf-slide-number{font-weight:700;opacity:.72;font-size:clamp(.8rem,1.6vw,1.1rem);color:rgb(135,175,215);}
.mdf-fullscreen-button{position:absolute;left:0;bottom:0;z-index:10;}
.mdf-fullscreen-button{width:clamp(48px,9vw,64px);height:clamp(48px,9vw,64px);border:0;background:transparent;color:transparent;opacity:0;}
.mdf-fullscreen-button{padding:0;font:0/0 monospace;border-radius:0;touch-action:manipulation;cursor:pointer;}
.mdf-deck.mdf-fallback-fullscreen{position:fixed;inset:0;z-index:2147483647;}
.mdf-deck[data-transition="hard"] .mdf-slide{transition:none;}
.mdf-deck[data-transition="cross"] .mdf-slide{transition:opacity 1600ms ease,visibility 0s linear 1600ms;}
.mdf-deck[data-transition="cross"] .mdf-slide[aria-hidden="false"]{transition:opacity 1600ms ease,visibility 0s linear 0s;}
.mdf-deck[data-transition="fade"] .mdf-slide{transition:opacity 520ms ease,visibility 0s linear 0s;}
.mdf-deck[data-transition="fade"] .mdf-slide[aria-hidden="false"]{transition:opacity 520ms ease,visibility 0s linear 0s;}
.mdf-deck.mdf-blackout .mdf-slide{opacity:0;}
@media (prefers-reduced-motion:reduce){.mdf-slide{transition:none!important;}}
</style>
</head>
<body>
<main class="mdf-deck" data-transition="fade" data-current="1">
<button class="mdf-fullscreen-button" type="button" tabindex="-1" aria-label="Toggle fullscreen"></button>
<section class="mdf-slide mdf-slide-front" data-slide="1" aria-hidden="false"><div class="mdf-slide-content"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># libmdf Deck Mode</span>
</div></section>
<section class="mdf-slide" data-slide="2" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Centered Front Page With More Content</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span class="mdf-heading" style="color:rgb(135,175,255);font-weight:700;font-size:22pt;font-weight:700;--mdf-heading-indent:3ch;">## Subtitle Block</span><span style="color:rgb(220,220,220);">This slide verifies that the first slide can include more than a single heading while still centering the content block.</span></div></div></div></section>
<section class="mdf-slide" data-slide="3" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Stable Heading Scale</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span class="mdf-heading" style="color:rgb(135,175,255);font-weight:700;font-size:22pt;font-weight:700;--mdf-heading-indent:3ch;">## Second-Level Heading</span><span class="mdf-heading" style="color:rgb(135,175,215);font-weight:700;font-size:15pt;font-weight:700;--mdf-heading-indent:4ch;">### Third-Level Heading</span><span class="mdf-heading" style="color:rgb(215,135,215);font-size:14pt;font-weight:700;--mdf-heading-indent:5ch;">#### Fourth-Level Heading</span><span class="mdf-heading" style="color:rgb(135,215,255);font-size:13pt;font-weight:700;--mdf-heading-indent:6ch;">##### Fifth-Level Heading</span><span class="mdf-heading" style="color:rgb(215,135,95);font-size:12.5pt;font-weight:700;--mdf-heading-indent:7ch;">###### Sixth-Level Heading</span><span style="color:rgb(220,220,220);">ATX headings should remain stable from slide to slide while body content participates in autofit.</span></div></div></div></section>
<section class="mdf-slide" data-slide="4" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Header And Body Heading Paths</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Body First-Level Heading</span><span class="mdf-heading" style="color:rgb(135,175,255);font-weight:700;font-size:22pt;font-weight:700;--mdf-heading-indent:3ch;">## Body Second-Level Heading</span><span class="mdf-heading" style="color:rgb(135,175,215);font-weight:700;font-size:15pt;font-weight:700;--mdf-heading-indent:4ch;">### Body Third-Level Heading</span><span class="mdf-heading" style="color:rgb(215,135,215);font-size:14pt;font-weight:700;--mdf-heading-indent:5ch;">#### Body Fourth-Level Heading</span><span class="mdf-heading" style="color:rgb(135,215,255);font-size:13pt;font-weight:700;--mdf-heading-indent:6ch;">##### Body Fifth-Level Heading</span><span style="color:rgb(220,220,220);">This paragraph verifies that headings in the slide body use the body-heading scale instead of the promoted slide-header scale. The smallest body heading on this slide should still read as a heading and must not become smaller than this paragraph text.</span></div></div></div></section>
<section class="mdf-slide" data-slide="5" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Sparse Body Autofit</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span style="color:rgb(220,220,220);">One short paragraph should become comfortably large without looking like a marketing splash page.</span></div></div></div></section>
<section class="mdf-slide" data-slide="6" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Dense Body Autofit</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span style="color:rgb(220,220,220);">This slide intentionally contains enough body content to force a smaller body font. The renderer should preserve readable spacing, keep headings predictable, and avoid clipping content in a typical fullscreen browser viewport.</span>

<span style="color:rgb(220,220,220);">Autofit should treat this as normal slide content rather than a failure mode. If a slide is too dense even at the minimum font size, the fallback should be visually obvious and still allow the presenter to reach all content.</span>

<span style="color:rgb(220,220,220);">The goal is to test the everyday case where a technical presenter adds a little too much detail but still expects the deck to adapt gracefully on desktop and laptop screens.</span></div></div></div></section>
<section class="mdf-slide" data-slide="7" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Inline Markdown</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span style="color:rgb(220,220,220);">Plain text can include </span><span style="color:rgb(135,175,215);font-style:italic;">emphasis</span><span style="color:rgb(220,220,220);">, </span><span style="color:rgb(135,175,255);font-weight:700;">strong text</span><span style="color:rgb(220,220,220);">, </span><span style="color:rgb(255,135,135);font-weight:700;font-style:italic;">combined emphasis</span><span style="color:rgb(220,220,220);">, </span><span style="color:rgb(95,135,175);">inline code</span><span style="color:rgb(220,220,220);">, </span><a href="https://example.com/deck" target="_blank" rel="noopener noreferrer"><span style="color:rgb(135,175,215);font-weight:700;text-decoration:underline;">links</span></a><span style="color:rgb(220,220,220);">, and autolinks like https://example.com/autolink.</span></div></div></div></section>
<section class="mdf-slide" data-slide="8" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Lists</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,175,215);">-</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(220,220,220);">Unordered item with a short label.</span></span></span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,175,215);">-</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(220,220,220);">Unordered item with </span><span style="color:rgb(135,175,215);font-style:italic;">inline emphasis</span><span style="color:rgb(220,220,220);">, </span><span style="color:rgb(135,175,255);font-weight:700;">strong text</span><span style="color:rgb(220,220,220);">, and </span><span style="color:rgb(95,135,175);">inline code</span><span style="color:rgb(220,220,220);">.</span></span></span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,175,215);">-</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(220,220,220);">Unordered item with nested structure:</span></span></span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(220,220,220);">  </span><span style="color:rgb(95,175,215);">-</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(220,220,220);">Nested unordered item.</span></span></span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(220,220,220);">  </span><span style="color:rgb(95,175,215);">-</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(220,220,220);">Nested item with </span><a href="https://example.com/nested" target="_blank" rel="noopener noreferrer"><span style="color:rgb(135,175,215);font-weight:700;text-decoration:underline;">a link</span></a><span style="color:rgb(220,220,220);">.</span></span></span>

<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,175,215);">1.</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(220,220,220);">Ordered item one.</span></span></span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,175,215);">2.</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(220,220,220);">Ordered item two with a longer sentence that should wrap cleanly.</span></span></span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,175,215);">3.</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(220,220,220);">Ordered item three.</span></div></div></div></section>
<section class="mdf-slide" data-slide="9" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Task Lists</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,175,215);">-</span><span style="color:rgb(220,220,220);"> [ ] </span></span><span class="mdf-content"><span style="color:rgb(220,220,220);">Unchecked task item.</span></span></span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,175,215);">-</span><span style="color:rgb(220,220,220);"> [x] </span></span><span class="mdf-content"><span style="color:rgb(220,220,220);">Checked task item.</span></span></span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,175,215);">-</span><span style="color:rgb(220,220,220);"> [ ] </span></span><span class="mdf-content"><span style="color:rgb(220,220,220);">Task item with enough text to wrap across more than one visual line when the browser viewport is narrow.</span></span></span>

<span style="color:rgb(220,220,220);">Task list rendering is a future Markdown extension in some contexts, so this slide also documents the desired visual target if task markers are supported.</span></div></div></div></section>
<section class="mdf-slide" data-slide="10" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Block Quotes</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(78,78,78);">&gt;</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(175,215,255);">A short quote should read as a distinct block.</span></span></span>

<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(78,78,78);">&gt;</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(175,215,255);">A longer quote should wrap cleanly and preserve the quote treatment across</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(175,215,255);">lines. It should not collide with the slide number indicator.</span></span></span>
<span style="color:rgb(78,78,78);">&gt;</span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(78,78,78);">&gt;</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(95,175,215);">-</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(175,215,255);">Quoted list item.</span></span></span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(78,78,78);">&gt;</span><span style="color:rgb(220,220,220);"> </span><span style="color:rgb(95,175,215);">-</span><span style="color:rgb(220,220,220);"> </span></span><span class="mdf-content"><span style="color:rgb(175,215,255);">Another quoted list item with </span><span style="color:rgb(135,175,255);font-weight:700;">strong text</span><span style="color:rgb(175,215,255);">.</span></span></span></div></div></div></section>
<section class="mdf-slide" data-slide="11" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Code</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span style="color:rgb(95,95,255);">int main(void)</span>
<span style="color:rgb(95,95,255);">{</span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,95,255);">    </span></span><span class="mdf-content"><span style="color:rgb(95,95,255);">const char *boundary = &#34;---&#34;;</span></span></span>
<span class="mdf-line"><span class="mdf-prefix"><span style="color:rgb(95,95,255);">    </span></span><span class="mdf-content"><span style="color:rgb(95,95,255);">return boundary[0] == &#39;-&#39; ? 0 : 1;</span></span></span>
<span style="color:rgb(95,95,255);">}</span>

<span style="color:rgb(220,220,220);">The fenced </span><span style="color:rgb(95,135,175);">---</span><span style="color:rgb(220,220,220);"> string above must not split the deck.</span></div></div></div></section>
<section class="mdf-slide" data-slide="12" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Preformatted Text</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><span style="color:rgb(95,95,255);">make test</span>
<span style="color:rgb(95,95,255);">cmdf --deck --slide-numbers -x fade -o deck.html testdata/deck-corpus/comprehensive.md</span>
<span style="color:rgb(95,95,255);">open deck.html</span>

<span style="color:rgb(220,220,220);">Indented code should remain readable and should not participate in Markdown slide boundary parsing.</span></div></div></div></section>
<section class="mdf-slide" data-slide="13" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Tables</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><table class="mdf-table mdf-table-bordered"><thead><tr><th style="text-align:left;">Capability</th><th style="text-align:center;">Desktop</th><th style="text-align:center;">Mobile</th><th style="text-align:left;">Notes</th></tr></thead><tbody><tr><td style="text-align:left;">Keyboard navigation</td><td style="text-align:center;">yes</td><td style="text-align:center;">yes</td><td style="text-align:left;">external keyboards should work</td></tr><tr><td style="text-align:left;">Touch navigation</td><td style="text-align:center;">yes</td><td style="text-align:center;">yes</td><td style="text-align:left;">horizontal and vertical swipes are supported</td></tr><tr><td style="text-align:left;">Autofit</td><td style="text-align:center;">yes</td><td style="text-align:center;">yes</td><td style="text-align:left;">body content adapts per slide</td></tr><tr><td style="text-align:left;">Charts</td><td style="text-align:center;">yes</td><td style="text-align:center;">yes</td><td style="text-align:left;">chart boxes stay inspectable</td></tr></tbody></table></div></div></div></section>
<section class="mdf-slide" data-slide="14" aria-hidden="true"><div class="mdf-slide-content mdf-slide-content-centered"><div class="mdf-slide-header"><span class="mdf-heading" style="color:rgb(255,175,215);font-weight:700;font-size:32pt;font-weight:700;--mdf-heading-indent:2ch;"># Wide Table Pressure</span></div><div class="mdf-slide-body"><div class="mdf-slide-body-inner"><table class="mdf-table mdf-table-bordered"><thead><tr><th style="text-align:left;">Column</th><th style="text-align:right;">Short</th><th style="text-align:left;">Medium length header</th><th style="text-align:left;">Long content pressure</th></tr></thead><tbody><tr><td style="text-align:left;">alpha</td><td style="text-align:right;">1</td><td style="text-align:left;">small</td><td style="text-align:left;">long text that should wrap inside the table cell without forcing the whole slide out of the viewport</td></tr><tr><td style="text-align:left;">beta</td><td style="text-align:right;">22</td><td style="text-align:left;">medium</td><td style="text-align:left;">another deliberately long table value with <span style="color:rgb(95,135,175);">inline code</span> and <span style="color:rgb(135,175,255);font-weight:700;">strong text</span></td></tr><tr><td style="text-align:left;">gamma</td><td style="text-align:right;">333</td><td style="text-align:left;">large</td><td style="text-align:left;"><a href="https://example.com/table/link" target="_blank" rel="noopener noreferrer"><span style="color:rgb(135,175,215);font-weight:700;text-decoration:underline;">a link with a descriptive label</span></a></td></tr></tbody></table></div></div></div></section>
